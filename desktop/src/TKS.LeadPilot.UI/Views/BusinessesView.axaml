<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKS.LeadPilot.UI.ViewModels"
             xmlns:m="using:TKS.LeadPilot.Core.Models"
             x:Class="TKS.LeadPilot.UI.Views.BusinessesView"
             x:DataType="vm:BusinessesViewModel">

    <Grid>
        <!-- Main Layout -->
        <Grid RowDefinitions="Auto,Auto,*" Margin="24">
            
            <!-- 1. Top Header & Primary Actions Toolbar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <!-- Left Title & Breadcrumb (Guaranteed no overflow) -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,3">
                        <TextBlock Text="Business Intelligence &amp; Discovery" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} Leads'}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="Search, segment, audit, and discover enterprise leads across global markets &amp; local proximities." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Right Action Buttons (Wraps gracefully on smaller windows) -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🛰️ Discover Leads (OSM)" Command="{Binding OpenDiscoveryModalCommand}" Classes="btn-accent" IsEnabled="{Binding !IsLoading}" Margin="0,0,8,4"/>
                    <Button Content="+ Add Business" Command="{Binding OpenAddBusinessModalCommand}" Classes="btn-primary" IsEnabled="{Binding !IsLoading}" Margin="0,0,8,4"/>
                    <Button Content="📥 Import CSV" Click="OnPickCsvFileClick" Classes="btn-secondary" IsEnabled="{Binding !IsLoading}" Margin="0,0,8,4"/>
                    <Button Content="📤 Export CSV" Command="{Binding ExportCsvCommand}" Classes="btn-secondary" IsEnabled="{Binding !IsLoading}" Margin="0,0,8,4"/>
                    <Button Content="📄 Export JSON" Command="{Binding ExportJsonCommand}" Classes="btn-secondary" IsEnabled="{Binding !IsLoading}" Margin="0,0,0,4"/>
                </WrapPanel>
            </Grid>

            <!-- 2. Enhanced Filter Ribbon Bar -->
            <Border Grid.Row="1" Background="#111A2C" BorderBrush="#223147" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                <StackPanel Spacing="10">
                    
                    <!-- Row 1: Cascading Geographic Location Hierarchy -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,10,6">
                                <TextBlock Text="📍" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="LOCATION:" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Country Dropdown -->
                            <ComboBox Width="180" ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Filter by Country" Margin="0,0,8,6"/>

                            <!-- State/Province Dropdown -->
                            <ComboBox Width="180" ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Filter by State or Province" Margin="0,0,8,6"/>

                            <!-- City Dropdown -->
                            <ComboBox Width="160" ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Filter by City" Margin="0,0,8,6"/>

                            <!-- Nearby Me Quick Button -->
                            <Button Content="📍 Nearby Me" Command="{Binding DetectNearbyLocationCommand}" IsEnabled="{Binding !IsLoading}" Classes="btn-accent" Margin="0,0,8,6" ToolTip.Tip="Detect and filter businesses within proximity radius"/>

                            <!-- Nearby Radius Selector -->
                            <ComboBox Width="95" ItemsSource="{Binding AvailableRadii}" SelectedItem="{Binding NearbyRadiusKm}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Proximity radius (km)" Margin="0,0,8,6">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:Double">
                                        <TextBlock Text="{Binding StringFormat='{}{0} km'}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </WrapPanel>

                        <!-- Active Proximity Indicator -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsNearbyActive}">
                            <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="12" Padding="8,3">
                                <TextBlock Text="📍 Proximity Active" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                            <Button Content="✕ Clear" Command="{Binding ClearNearbyCommand}" Classes="btn-danger-ghost" Padding="6,2" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="#1D2A3D"/>

                    <!-- Row 2: Search, Category, Status & Action Buttons -->
                    <WrapPanel VerticalAlignment="Center">
                        <!-- Free-text Search -->
                        <TextBox Width="260" Text="{Binding SearchQuery}" IsEnabled="{Binding !IsLoading}" PlaceholderText="Search name, phone, email, tags..." Margin="0,0,8,6" VerticalContentAlignment="Center"/>

                        <!-- Category Dropdown -->
                        <ComboBox Width="200" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Filter by Business Category" Margin="0,0,8,6"/>

                        <!-- Website Filter -->
                        <ComboBox Width="130" ItemsSource="{Binding WebsiteFilters}" SelectedItem="{Binding SelectedWebsiteFilter}" IsEnabled="{Binding !IsLoading}" Margin="0,0,8,6"/>

                        <!-- Pipeline Stage Dropdown -->
                        <ComboBox Width="150" ItemsSource="{Binding PipelineStages}" SelectedItem="{Binding SelectedStage}" IsEnabled="{Binding !IsLoading}" PlaceholderText="All Stages" Margin="0,0,8,6">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:PipelineStage">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Sort By Dropdown -->
                        <ComboBox Width="160" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Sort order for leads" Margin="0,0,8,6"/>

                        <!-- Action Buttons -->
                        <Button Content="Filter" Command="{Binding ApplyFiltersCommand}" Classes="btn-primary" IsEnabled="{Binding !IsLoading}" Margin="0,0,6,6"/>
                        <Button Content="Reset All" Command="{Binding ResetFiltersCommand}" Classes="btn-secondary" IsEnabled="{Binding !IsLoading}" Margin="0,0,6,6"/>
                    </WrapPanel>

                    <!-- Row 3: Quick Filter Preset Pills -->
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="QUICK FILTERS:" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <Button Content="All Leads" Command="{Binding ClearQuickFilterCommand}" Classes="pill-filter" IsEnabled="{Binding !IsLoading}" Margin="0,0,5,4"/>
                        <Button Content="🔥 Hot Leads (70+)" Command="{Binding ApplyQuickFilterCommand}" CommandParameter="🔥 Hot Leads" Classes="pill-filter" IsEnabled="{Binding !IsLoading}" Margin="0,0,5,4"/>
                        <Button Content="❌ No Website" Command="{Binding ApplyQuickFilterCommand}" CommandParameter="❌ No Website" Classes="pill-filter" IsEnabled="{Binding !IsLoading}" Margin="0,0,5,4"/>
                        <Button Content="📍 Missing GMB" Command="{Binding ApplyQuickFilterCommand}" CommandParameter="📍 Missing GMB" Classes="pill-filter" IsEnabled="{Binding !IsLoading}" Margin="0,0,5,4"/>
                        <Button Content="✓ Verified Only" Command="{Binding ApplyQuickFilterCommand}" CommandParameter="✓ Verified" Classes="pill-filter" IsEnabled="{Binding !IsLoading}" Margin="0,0,5,4"/>
                        <Button Content="⭐ Top Rated (4.5+)" Command="{Binding ApplyQuickFilterCommand}" CommandParameter="⭐ Top Rated" Classes="pill-filter" IsEnabled="{Binding !IsLoading}" Margin="0,0,5,4"/>
                        <Button Content="🔬 Needs Audit" Command="{Binding ApplyQuickFilterCommand}" CommandParameter="Needs Audit" Classes="pill-filter" IsEnabled="{Binding !IsLoading}" Margin="0,0,5,4"/>
                    </WrapPanel>

                    <!-- Row 4: Suggested Regional Business Niches -->
                    <WrapPanel VerticalAlignment="Center" IsVisible="{Binding SuggestedNiches.Count}">
                        <TextBlock Text="💡 SUGGESTED NICHES:" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <ItemsControl ItemsSource="{Binding SuggestedNiches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Content="{Binding}" 
                                            Command="{Binding ((vm:BusinessesViewModel)DataContext).SelectSuggestedNicheCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Classes="niche-pill"
                                            Margin="0,0,6,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <!-- Loading Progress Bar -->
                    <ProgressBar IsIndeterminate="True" Height="2" Background="Transparent" Foreground="#38BDF8" IsVisible="{Binding IsLoading}" Margin="0,-4,0,0"/>

                    <!-- Filter Summary & Status Bar -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="14" Margin="10,0,0,0">
                            <TextBlock Text="{Binding FilteredCount, StringFormat='Showing: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                            <TextBlock Text="{Binding HotLeadsCount, StringFormat='🔥 High Opportunity: {0}'}" FontSize="12" Foreground="#F59E0B"/>
                            <TextBlock Text="{Binding VerifiedCount, StringFormat='✓ Google Verified: {0}'}" FontSize="12" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Master-Detail Split Grid -->
            <Grid Grid.Row="2" ColumnDefinitions="2*,1*">
                <!-- Left: DataGrid Pane -->
                <Border Grid.Column="0" Margin="0,0,8,0" Background="#111A2C" BorderBrush="#223147" BorderThickness="1" CornerRadius="8">
                    <DataGrid ItemsSource="{Binding Businesses}"
                              SelectedItem="{Binding SelectedBusiness}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              IsEnabled="{Binding !IsLoading}"
                              GridLinesVisibility="Horizontal"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              RowBackground="#111A2C"
                              BorderThickness="0"
                              CornerRadius="8">
                        <DataGrid.Columns>
                            <!-- Star Toggle -->
                            <DataGridTemplateColumn Header="★" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="m:Business">
                                        <TextBlock Text="{Binding StarDisplay}"
                                                   Foreground="#FBBF24"
                                                   FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Business Name" Binding="{Binding Name}" Width="1.8*" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.2*" />
                            <DataGridTextColumn Header="City" Binding="{Binding City}" Width="95" />
                            <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="105" />
                            <DataGridTextColumn Header="Website" Binding="{Binding WebsiteUrl}" Width="1.2*" />
                            <DataGridTextColumn Header="Score" Binding="{Binding LeadScore}" Width="65" />
                            <DataGridTextColumn Header="Stage" Binding="{Binding PipelineStage.Name}" Width="1.1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Right: Split Inspector Pane -->
                <Border Grid.Column="1" Margin="8,0,0,0" Background="#111A2C" BorderBrush="#223147" BorderThickness="1" CornerRadius="8" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" DataContext="{Binding SelectedBusiness}">
                            <!-- Business Header -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,2,0,0">
                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#38BDF8"/>
                                        </Border>
                                        <Border Background="#064E3B" CornerRadius="4" Padding="6,2" IsVisible="{Binding IsGoogleVerified}">
                                            <TextBlock Text="✓ Google Verified" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Score Card -->
                                <Border Grid.Column="1" Background="#10B981" CornerRadius="6" Padding="10,6" VerticalAlignment="Top" Margin="8,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding LeadScore}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        <TextBlock Text="SCORE" FontSize="9" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Separator Background="#223147"/>

                            <!-- Location Card -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="GEOGRAPHIC LOCATION" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <Grid ColumnDefinitions="*,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding City, StringFormat='City: {0}'}" FontSize="12" Foreground="#F8FAFC"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StateProvince, StringFormat='State: {0}'}" FontSize="12" Foreground="#94A3B8"/>
                                </Grid>
                                <TextBlock Text="{Binding Country, StringFormat='Country: {0}'}" FontSize="12" Foreground="#F8FAFC"/>
                                <TextBlock Text="{Binding AddressLine1, StringFormat='Address: {0}'}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Separator Background="#223147"/>

                            <!-- Contact & Digital Footprint -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="CONTACT &amp; DIGITAL PRESENCE" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding PhonePrimary, StringFormat='Phone: {0}', TargetNullValue='Phone: None'}" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding EmailPrimary, StringFormat='Email: {0}', TargetNullValue='Email: None'}" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding WebsiteUrl, StringFormat='Website: {0}', TargetNullValue='Website: ❌ No Website'}" FontSize="12" Foreground="#38BDF8" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Separator Background="#223147"/>

                            <!-- Tags -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="TAGS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <Border Background="#1E293B" CornerRadius="4" Padding="8">
                                    <TextBlock Text="{Binding Tags, TargetNullValue='No tags assigned'}" FontSize="12" Foreground="#F59E0B" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <Separator Background="#223147"/>

                            <!-- Key Contacts Section -->
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="CONTACTS" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+ Add Contact" 
                                            Command="{Binding ((vm:BusinessesViewModel)DataContext).OpenAddContactModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Classes="btn-secondary" Padding="8,4" FontSize="11"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Contacts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:BusinessContact">
                                            <Border Background="#1A2538" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                                        <TextBlock Text="{Binding JobTitle}" FontSize="11" Foreground="#94A3B8"/>
                                                        <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding Email}" FontSize="11" Foreground="#38BDF8"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="✕" 
                                                            Command="{Binding ((vm:BusinessesViewModel)DataContext).DeleteContactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}"
                                                            Classes="btn-danger-ghost" Padding="6,2" VerticalAlignment="Top"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Separator Background="#223147"/>

                            <!-- Google Places Details (Stage 7) -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsGoogleVerified}">
                                <TextBlock Text="GOOGLE PLACES ENRICHMENT" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="✓ Verified Place" FontSize="12" FontWeight="Bold" Foreground="#34D399"/>
                                            <TextBlock Text="{Binding GoogleRating, StringFormat='★ {0:F1}'}" FontSize="12" FontWeight="Bold" Foreground="#FBBF24"/>
                                            <TextBlock Text="{Binding GoogleReviewCount, StringFormat='({0} reviews)'}" FontSize="12" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding BusinessHours, StringFormat='Hours: {0}'}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding LastEnrichedAtUtc, StringFormat='Last synced: {0:yyyy-MM-dd HH:mm} UTC'}" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Separator Background="#223147"/>

                            <!-- Quick Outreach & Lead Utilities -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="QUICK OUTREACH &amp; ACTIONS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <Button Content="📋 Copy Tailored Pitch" 
                                        Command="{Binding ((vm:BusinessesViewModel)DataContext).CopyQuickPitchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        Classes="btn-accent" HorizontalAlignment="Stretch"/>
                                <Button Content="🌐 Launch Website in Browser" 
                                        Command="{Binding ((vm:BusinessesViewModel)DataContext).OpenWebsiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        Classes="btn-primary" HorizontalAlignment="Stretch"
                                        IsVisible="{Binding WebsiteUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <Grid ColumnDefinitions="*,*">
                                    <Button Grid.Column="0" Content="📞 Copy Phone" 
                                            Command="{Binding ((vm:BusinessesViewModel)DataContext).CopyPhoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            Classes="btn-secondary" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                            IsVisible="{Binding PhonePrimary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <Button Grid.Column="1" Content="✉️ Copy Email" 
                                            Command="{Binding ((vm:BusinessesViewModel)DataContext).CopyEmailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            Classes="btn-secondary" HorizontalAlignment="Stretch" Margin="4,0,0,0"
                                            IsVisible="{Binding EmailPrimary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </Grid>
                            </StackPanel>

                            <Separator Background="#223147"/>

                            <!-- Record Management -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="RECORD MANAGEMENT" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <Button Content="✨ Enrich with Google Places" 
                                        Command="{Binding ((vm:BusinessesViewModel)DataContext).OpenEnrichConfirmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        HorizontalAlignment="Stretch" Classes="btn-teal"/>
                                <Button Content="⭐ Toggle Starred"
                                        Command="{Binding ((vm:BusinessesViewModel)DataContext).ToggleStarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch" Classes="btn-secondary"/>
                                <Button Content="🗑️ Delete Business" 
                                        Command="{Binding ((vm:BusinessesViewModel)DataContext).DeleteBusinessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        HorizontalAlignment="Stretch" Classes="btn-danger-ghost"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- 4. MODALS OVERLAYS -->

        <!-- Add Business Modal Overlay -->
        <Border Background="#C0090D16" IsVisible="{Binding IsAddBusinessModalOpen}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Width="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="Add New Enterprise Business" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Enter business details. Duplicate checks across websites &amp; phones run automatically." FontSize="12" Foreground="#94A3B8"/>

                    <StackPanel Spacing="10">
                        <TextBox Text="{Binding NewBusinessName}" PlaceholderText="Business Name (Required)"/>
                        <TextBox Text="{Binding NewBusinessCategory}" PlaceholderText="Category (e.g. Healthcare, Legal, Tech, Logistics)"/>
                        
                        <!-- Country & State -->
                        <Grid ColumnDefinitions="*,*">
                            <TextBox Grid.Column="0" Text="{Binding NewBusinessCountry}" PlaceholderText="Country" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NewBusinessState}" PlaceholderText="State / Province" Margin="6,0,0,0"/>
                        </Grid>

                        <TextBox Text="{Binding NewBusinessCity}" PlaceholderText="City"/>
                        <TextBox Text="{Binding NewBusinessPhone}" PlaceholderText="Primary Phone (e.g. +92 300 1234567)"/>
                        <TextBox Text="{Binding NewBusinessEmail}" PlaceholderText="Primary Email"/>
                        <TextBox Text="{Binding NewBusinessWebsite}" PlaceholderText="Website URL (e.g. https://example.com)"/>
                        <TextBox Text="{Binding NewBusinessTags}" PlaceholderText="Tags (comma-separated)"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding CloseAddBusinessModalCommand}" Classes="btn-secondary"/>
                        <Button Content="Save Business" Command="{Binding SaveNewBusinessCommand}" Classes="btn-primary"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Add Contact Modal Overlay -->
        <Border Background="#C0090D16" IsVisible="{Binding IsAddContactModalOpen}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Width="440" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="Add Key Business Contact" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="{Binding SelectedBusiness.Name, StringFormat='Adding key decision maker for {0}'}" FontSize="12" Foreground="#38BDF8"/>

                    <StackPanel Spacing="10">
                        <TextBox Text="{Binding NewContactFullName}" PlaceholderText="Full Name (Required)"/>
                        <TextBox Text="{Binding NewContactJobTitle}" PlaceholderText="Job Title (e.g. CEO, Principal Doctor, IT Director)"/>
                        <TextBox Text="{Binding NewContactEmail}" PlaceholderText="Email Address"/>
                        <TextBox Text="{Binding NewContactPhone}" PlaceholderText="Direct Phone / WhatsApp"/>
                        <CheckBox Content="Mark as Primary Decision Maker" IsChecked="{Binding NewContactIsPrimary}" Foreground="#F8FAFC"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding CloseAddContactModalCommand}" Classes="btn-secondary"/>
                        <Button Content="Add Contact" Command="{Binding SaveNewContactCommand}" Classes="btn-primary"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- CSV Import Modal Overlay -->
        <Border Background="#C0090D16" IsVisible="{Binding IsImportModalOpen}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Width="640" MaxHeight="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="CSV Spreadsheet Lead Import" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="RFC 4180 compliant CSV parser with automated column synonym mapping &amp; pre-flight duplicate detection." FontSize="12" Foreground="#94A3B8"/>

                    <Border Background="#0F172A" CornerRadius="6" Padding="12" IsVisible="{Binding ImportPreview, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="6" DataContext="{Binding ImportPreview}">
                            <TextBlock Text="{Binding TotalRows, StringFormat='Total Rows: {0}'}" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            <TextBlock Text="{Binding ValidRows, StringFormat='Valid Unique Leads: {0}'}" Foreground="#10B981"/>
                            <TextBlock Text="{Binding DuplicateRows, StringFormat='Potential Duplicates: {0}'}" Foreground="#F59E0B"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="6" Margin="0,6">
                        <TextBlock Text="Duplicate Resolution Strategy:" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,4">
                            <RadioButton Content="Skip Duplicates (Safe)" IsChecked="True" GroupName="DedupStrategy" Foreground="#F8FAFC"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding CloseImportModalCommand}" Classes="btn-secondary" IsEnabled="{Binding !IsImporting}"/>
                        <Button Content="Execute Import" Command="{Binding ExecuteImportCommand}" Classes="btn-primary" IsEnabled="{Binding !IsImporting}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Discovery Modal Overlay (Cascading Hierarchies + Full Field Disabling during Scan) -->
        <Border Background="#C0090D16" IsVisible="{Binding IsDiscoveryModalOpen}">
            <Border Background="#162235" BorderBrush="#2D405D" BorderThickness="1" CornerRadius="12" Width="820" MaxHeight="680" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Header -->
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="OpenStreetMap Lead Discovery Engine" FontSize="19" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock Text="Scan public OpenStreetMap Overpass servers for businesses, clinics, and enterprises without API fees." FontSize="12" Foreground="#94A3B8"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="📍 Use Nearby Location" Command="{Binding SetDiscoveryNearbyCommand}" Classes="btn-accent" IsEnabled="{Binding !IsDiscovering}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Filter Controls (All fields disabled during scan) -->
                    <Border Grid.Row="1" Background="#0C1422" BorderBrush="#1F2F47" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel Spacing="10">
                            <!-- Location Cascade -->
                            <Grid ColumnDefinitions="*,*,*">
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Target Country:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding DiscoveryCountries}" SelectedItem="{Binding SelectedDiscoveryCountry}" IsEnabled="{Binding !IsDiscovering}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                    <TextBlock Text="State / Province:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding DiscoveryStates}" SelectedItem="{Binding SelectedDiscoveryState}" IsEnabled="{Binding !IsDiscovering}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="Target City:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding DiscoveryCities}" SelectedItem="{Binding SelectedDiscoveryCity}" IsEnabled="{Binding !IsDiscovering}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Category Preset & Action -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Business Category Preset:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding DiscoveryCategoryPresets}" SelectedItem="{Binding SelectedDiscoveryCategoryPreset}" IsEnabled="{Binding !IsDiscovering}"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="🛰️ Start Overpass Scan" Command="{Binding StartDiscoveryScanCommand}" Classes="btn-accent" IsEnabled="{Binding !IsDiscovering}" Padding="18,10" VerticalAlignment="Bottom"/>
                            </Grid>

                            <!-- Suggested Opportunities Bar (Disabled during scan) -->
                            <WrapPanel VerticalAlignment="Center" IsVisible="{Binding DiscoverySuggestedNiches.Count}">
                                <TextBlock Text="💡 SUGGESTED NICHES:" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <ItemsControl ItemsSource="{Binding DiscoverySuggestedNiches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button Content="{Binding}" 
                                                    Command="{Binding ((vm:BusinessesViewModel)DataContext).SelectDiscoveryNicheCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Classes="niche-pill"
                                                    Margin="0,0,6,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Results / Status Pane -->
                    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" Margin="0,0,0,12">
                        <!-- Scanning Progress Bar -->
                        <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="3" Background="Transparent" Foreground="#0EA5E9" IsVisible="{Binding IsDiscovering}" Margin="0,0,0,6"/>

                        <!-- Stats Bar -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="{Binding DiscoveryStatus}" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="10,0,0,0">
                                <TextBlock Text="{Binding DiscoveredTotal, StringFormat='Found: {0}'}" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding DiscoveredNew, StringFormat='New Leads: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock Text="{Binding DiscoveredDuplicates, StringFormat='Duplicates: {0}'}" FontSize="12" Foreground="#F59E0B"/>
                            </StackPanel>
                        </Grid>

                        <!-- Discovered Leads Preview DataGrid (Disabled during scan) -->
                        <Border Grid.Row="2" Background="#0C1422" BorderBrush="#1F2F47" BorderThickness="1" CornerRadius="6" MinHeight="200">
                            <DataGrid ItemsSource="{Binding DiscoveredLeads}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False"
                                      IsEnabled="{Binding !IsDiscovering}"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      BorderThickness="0"
                                      RowBackground="#0C1422">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Import" Binding="{Binding IsSelectedForImport}" Width="45" />
                                    <DataGridTextColumn Header="Business Name" Binding="{Binding Business.Name}" IsReadOnly="True" Width="1.8*" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Business.Category}" IsReadOnly="True" Width="1.3*" />
                                    <DataGridTextColumn Header="City" Binding="{Binding Business.City}" IsReadOnly="True" Width="100" />
                                    <DataGridTextColumn Header="Website" Binding="{Binding Business.WebsiteUrl}" IsReadOnly="True" Width="1.3*" />
                                    <DataGridTextColumn Header="Phone" Binding="{Binding Business.PhonePrimary}" IsReadOnly="True" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- Footer Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="Close" Command="{Binding CloseDiscoveryModalCommand}" Classes="btn-secondary" IsEnabled="{Binding !IsDiscovering}"/>
                        <Button Content="Import Selected Leads" Command="{Binding ExecuteDiscoveryImportCommand}" Classes="btn-success" IsEnabled="{Binding !IsDiscovering}" Padding="18,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Google Places Enrichment Confirmation Modal Overlay (Stage 7) -->
        <Border Background="#C0090D16" IsVisible="{Binding IsEnrichConfirmModalOpen}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Width="480" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Google Places Enrichment" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Border Grid.Column="1" Background="#064E3B" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="COST GUARD" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>
                    </Grid>
                    
                    <TextBlock Text="{Binding EnrichConfirmMessage}" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="20"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEnrichingWithGoogle}">
                        <ProgressBar IsIndeterminate="True" Width="100" Height="4"/>
                        <TextBlock Text="Querying Google Places API..." FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding CloseEnrichConfirmCommand}" Classes="btn-secondary" IsEnabled="{Binding !IsEnrichingWithGoogle}"/>
                        <Button Content="Confirm &amp; Enrich" Command="{Binding ExecuteGooglePlacesEnrichmentCommand}" Classes="btn-teal" IsEnabled="{Binding !IsEnrichingWithGoogle}" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
