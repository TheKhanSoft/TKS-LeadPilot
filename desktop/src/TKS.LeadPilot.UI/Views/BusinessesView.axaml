<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKS.LeadPilot.UI.ViewModels"
             xmlns:m="using:TKS.LeadPilot.Core.Models"
             x:Class="TKS.LeadPilot.UI.Views.BusinessesView"
             x:DataType="vm:BusinessesViewModel">

    <Grid>
        <!-- Main Layout (Maximized space for DataGrid) -->
        <Grid RowDefinitions="Auto,Auto,*" Margin="14,10,14,10">
            
            <!-- 1. Top Header & Primary Actions Toolbar (Compact Single-Row Design) -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <!-- Left Title & Lead Counter Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Business Intelligence" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} Leads'}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>
                </StackPanel>

                <!-- Right Action Buttons -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="⚡ Lead Discovery" 
                            Command="{Binding OpenDiscoveryStationCommand}" 
                            Classes="btn-accent" IsEnabled="{Binding !IsLoading}" Margin="0,0,6,2" Padding="12,5" FontSize="11"
                            ToolTip.Tip="Launch dedicated multi-source lead discovery station"/>
                    <Button Content="+ Add Business" Command="{Binding OpenAddBusinessModalCommand}" Classes="btn-primary" IsEnabled="{Binding !IsLoading}" Margin="0,0,6,2" Padding="12,5" FontSize="11"/>
                    <Button Content="📥 Import CSV" Click="OnPickCsvFileClick" Classes="btn-secondary" IsEnabled="{Binding !IsLoading}" Margin="0,0,6,2" Padding="10,5" FontSize="11"/>
                    <Button Content="📤 Export CSV" Command="{Binding ExportCsvCommand}" Classes="btn-secondary" IsEnabled="{Binding !IsLoading}" Margin="0,0,6,2" Padding="10,5" FontSize="11"/>
                    <Button Content="📄 Export JSON" Command="{Binding ExportJsonCommand}" Classes="btn-secondary" IsEnabled="{Binding !IsLoading}" Margin="0,0,0,2" Padding="10,5" FontSize="11"/>
                </WrapPanel>
            </Grid>

            <!-- 2. Responsive & Compact Filter Ribbon (Drastically reduced vertical height) -->
            <Border Grid.Row="1" Background="#111A2C" BorderBrush="#223147" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                    <!-- Top Action Strip: Search, Category, Country, Advanced Filter Toggle, Buttons & Detail Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <!-- Free-text Search -->
                            <TextBox Width="190" Text="{Binding SearchQuery}" IsEnabled="{Binding !IsLoading}" PlaceholderText="Search name, phone, tags..." Margin="0,0,6,4" Padding="8,4" FontSize="12" VerticalContentAlignment="Center"/>

                            <!-- Category Dropdown -->
                            <ComboBox Width="160" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Filter by Business Category" Margin="0,0,6,4" Padding="8,4" FontSize="11"/>

                            <!-- Country Dropdown -->
                            <ComboBox Width="135" ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Filter by Country" Margin="0,0,6,4" Padding="8,4" FontSize="11"/>

                            <!-- Advanced Filters Drawer Toggle -->
                            <Button Content="{Binding AdvancedFiltersToggleText}"
                                    Command="{Binding ToggleAdvancedFiltersCommand}"
                                    Classes="pill-filter"
                                    Foreground="#38BDF8"
                                    BorderBrush="#0284C7"
                                    Padding="10,4"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Margin="0,0,6,4"
                                    ToolTip.Tip="Toggle granular filters (State, City, Score, Contact, Niches)"/>

                            <!-- Action Buttons -->
                            <Button Content="Filter" Command="{Binding ApplyFiltersCommand}" Classes="btn-primary" IsEnabled="{Binding !IsLoading}" Padding="12,4" FontSize="11" Margin="0,0,4,4"/>
                            <Button Content="Reset All" Command="{Binding ResetFiltersCommand}" Classes="btn-secondary" IsEnabled="{Binding !IsLoading}" Padding="10,4" FontSize="11" Margin="0,0,6,4"/>
                        </WrapPanel>

                        <!-- Right Detail Pane Toggle -->
                        <Button Grid.Column="1" 
                                Content="{Binding DetailPaneToggleText}"
                                Command="{Binding ToggleDetailPaneCommand}"
                                Classes="pill-filter"
                                Foreground="#94A3B8"
                                Padding="10,4"
                                FontSize="11"
                                VerticalAlignment="Top"
                                Margin="4,0,0,4"
                                ToolTip.Tip="Toggle side inspection detail card for more grid width"/>
                    </Grid>

                    <!-- Collapsible Advanced Filters Drawer -->
                    <Border Background="#0C1422" BorderBrush="#1E2A3B" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,2,0,2" IsVisible="{Binding IsAdvancedFiltersExpanded}">
                        <StackPanel Spacing="6">
                            <!-- Advanced Row 1: Deep Location & Proximity -->
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="📍 LOCATION:" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                <ComboBox Width="150" ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Filter by State or Province" Margin="0,0,6,4" Padding="8,3" FontSize="11"/>
                                <ComboBox Width="140" ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Filter by City" Margin="0,0,6,4" Padding="8,3" FontSize="11"/>
                                <Button Content="📍 Nearby Me" Command="{Binding DetectNearbyLocationCommand}" IsEnabled="{Binding !IsLoading}" Classes="btn-accent" Padding="8,3" FontSize="11" Margin="0,0,6,4" ToolTip.Tip="Detect and filter businesses within proximity radius"/>
                                <ComboBox Width="85" ItemsSource="{Binding AvailableRadii}" SelectedItem="{Binding NearbyRadiusKm}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Proximity radius (km)" Margin="0,0,6,4" Padding="8,3" FontSize="11">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:Double">
                                            <TextBlock Text="{Binding StringFormat='{}{0} km'}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsNearbyActive}" Margin="0,0,0,4">
                                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="10" Padding="6,2">
                                        <TextBlock Text="📍 Proximity Active" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                    </Border>
                                    <Button Content="✕ Clear" Command="{Binding ClearNearbyCommand}" Classes="btn-danger-ghost" Padding="4,1" FontSize="10"/>
                                </StackPanel>
                            </WrapPanel>

                            <!-- Advanced Row 2: Granular Filters & Sorting -->
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="⚙️ CRITERIA:" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                <ComboBox Width="110" ItemsSource="{Binding WebsiteFilters}" SelectedItem="{Binding SelectedWebsiteFilter}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Filter by Website Presence" Margin="0,0,6,4" Padding="8,3" FontSize="11"/>
                                <ComboBox Width="170" ItemsSource="{Binding ScoreFilters}" SelectedItem="{Binding SelectedScoreFilter}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Filter by Opportunity Score" Margin="0,0,6,4" Padding="8,3" FontSize="11"/>
                                <ComboBox Width="135" ItemsSource="{Binding ContactFilters}" SelectedItem="{Binding SelectedContactFilter}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Filter by Contact Availability" Margin="0,0,6,4" Padding="8,3" FontSize="11"/>
                                <ComboBox Width="125" ItemsSource="{Binding PipelineStages}" SelectedItem="{Binding SelectedStage}" IsEnabled="{Binding !IsLoading}" PlaceholderText="All Stages" Margin="0,0,6,4" Padding="8,3" FontSize="11">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="m:PipelineStage">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Width="150" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Sort Order" Margin="0,0,6,4" Padding="8,3" FontSize="11"/>
                            </WrapPanel>

                            <!-- Advanced Row 3: Suggested Niches -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding SuggestedNiches.Count}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="💡 SUGGESTED NICHES:" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ItemsControl ItemsSource="{Binding SuggestedNiches}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Button Content="{Binding}" 
                                                        Command="{Binding ((vm:BusinessesViewModel)DataContext).SelectSuggestedNicheCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Classes="niche-pill"
                                                        Padding="8,3"
                                                        FontSize="11"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Quick Filters & Status Bar (Horizontal Compact Strip) -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                        <!-- Quick Filters Scrollable Strip -->
                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="QUICK:" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="All" Command="{Binding ClearQuickFilterCommand}" Classes="pill-filter" IsEnabled="{Binding !IsLoading}" Padding="8,3" FontSize="11"/>
                                <Button Content="🔥 Hot Leads (70+)" Command="{Binding ApplyQuickFilterCommand}" CommandParameter="🔥 Hot Leads" Classes="pill-filter" IsEnabled="{Binding !IsLoading}" Padding="8,3" FontSize="11"/>
                                <Button Content="❌ No Website" Command="{Binding ApplyQuickFilterCommand}" CommandParameter="❌ No Website" Classes="pill-filter" IsEnabled="{Binding !IsLoading}" Padding="8,3" FontSize="11"/>
                                <Button Content="📍 Missing GMB" Command="{Binding ApplyQuickFilterCommand}" CommandParameter="📍 Missing GMB" Classes="pill-filter" IsEnabled="{Binding !IsLoading}" Padding="8,3" FontSize="11"/>
                                <Button Content="✓ Verified" Command="{Binding ApplyQuickFilterCommand}" CommandParameter="✓ Verified" Classes="pill-filter" IsEnabled="{Binding !IsLoading}" Padding="8,3" FontSize="11"/>
                                <Button Content="⭐ Top Rated (4.5+)" Command="{Binding ApplyQuickFilterCommand}" CommandParameter="⭐ Top Rated" Classes="pill-filter" IsEnabled="{Binding !IsLoading}" Padding="8,3" FontSize="11"/>
                                <Button Content="⭐ Starred" Command="{Binding ApplyQuickFilterCommand}" CommandParameter="⭐ Starred" Classes="pill-filter" IsEnabled="{Binding !IsLoading}" Padding="8,3" FontSize="11"/>
                                <Button Content="📞 Phone" Command="{Binding ApplyQuickFilterCommand}" CommandParameter="📞 Has Phone" Classes="pill-filter" IsEnabled="{Binding !IsLoading}" Padding="8,3" FontSize="11"/>
                                <Button Content="🔬 Audit" Command="{Binding ApplyQuickFilterCommand}" CommandParameter="Needs Audit" Classes="pill-filter" IsEnabled="{Binding !IsLoading}" Padding="8,3" FontSize="11"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Right Live Counters -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="8,0,0,0">
                            <!-- Showing Total Counter -->
                            <Button Content="{Binding ShowingSummaryText}"
                                    Command="{Binding ClearQuickFilterCommand}"
                                    Classes="pill-filter"
                                    Foreground="#10B981"
                                    FontWeight="Bold"
                                    FontSize="11"
                                    Padding="8,3"
                                    ToolTip.Tip="Click to show all leads"/>

                            <!-- High Opportunity Filter Pill -->
                            <Button Content="{Binding HotLeadsCount, StringFormat='🔥 High Opp: {0}'}"
                                    Command="{Binding ApplyQuickFilterCommand}"
                                    CommandParameter="🔥 Hot Leads"
                                    Classes="pill-filter"
                                    Foreground="#F59E0B"
                                    FontWeight="SemiBold"
                                    FontSize="11"
                                    Padding="8,3"
                                    ToolTip.Tip="Click to filter by High Opportunity (Score 70+)"/>

                            <!-- Google Verified Filter Pill -->
                            <Button Content="{Binding VerifiedCount, StringFormat='✓ Verified: {0}'}"
                                    Command="{Binding ApplyQuickFilterCommand}"
                                    CommandParameter="✓ Verified"
                                    Classes="pill-filter"
                                    Foreground="#38BDF8"
                                    FontWeight="SemiBold"
                                    FontSize="11"
                                    Padding="8,3"
                                    ToolTip.Tip="Click to filter by Google Verified"/>
                        </StackPanel>
                    </Grid>

                    <!-- Loading Progress Bar -->
                    <ProgressBar IsIndeterminate="True" Height="2" Background="Transparent" Foreground="#38BDF8" IsVisible="{Binding IsLoading}" Margin="0,-2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 3. Master-Detail Split Grid (Dynamic resizing with GridSplitter + Hide Details toggle) -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
                <!-- Left: DataGrid Pane -->
                <Border Grid.Column="0" Background="#111A2C" BorderBrush="#223147" BorderThickness="1" CornerRadius="8">
                    <DataGrid ItemsSource="{Binding Businesses}"
                              SelectedItem="{Binding SelectedBusiness}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              IsEnabled="{Binding !IsLoading}"
                              GridLinesVisibility="Horizontal"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              RowBackground="#111A2C"
                              BorderThickness="0"
                              CornerRadius="8">
                        <DataGrid.Columns>
                            <!-- Star Toggle -->
                            <DataGridTemplateColumn Header="★" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="m:Business">
                                        <TextBlock Text="{Binding StarDisplay}"
                                                   Foreground="#FBBF24"
                                                   FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Business Name" Binding="{Binding Name}" Width="200" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" />
                            <DataGridTextColumn Header="City" Binding="{Binding City}" Width="100" />
                            <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="95" />
                            <DataGridTextColumn Header="Website" Binding="{Binding WebsiteUrl}" Width="160" />
                            <DataGridTextColumn Header="Score" Binding="{Binding LeadScore}" Width="65" />
                            <DataGridTextColumn Header="Stage" Binding="{Binding PipelineStage.Name}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Resizable Column Splitter -->
                <GridSplitter Grid.Column="1" Width="5" Background="#1D2A3D" ResizeDirection="Columns" IsVisible="{Binding IsDetailPaneVisible}" Cursor="SizeWestEast" Margin="3,0"/>

                <!-- Right: Split Inspector Pane (Width 360, collapsible) -->
                <Border Grid.Column="2" Width="360" Background="#111A2C" BorderBrush="#223147" BorderThickness="1" CornerRadius="8" Padding="14" IsVisible="{Binding IsDetailPaneVisible}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" DataContext="{Binding SelectedBusiness}">
                            <!-- Business Header -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,2,0,0">
                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#38BDF8"/>
                                        </Border>
                                        <Border Background="#064E3B" CornerRadius="4" Padding="6,2" IsVisible="{Binding IsGoogleVerified}">
                                            <TextBlock Text="✓ Google Verified" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Score Card -->
                                <Border Grid.Column="1" Background="#10B981" CornerRadius="6" Padding="10,6" VerticalAlignment="Top" Margin="8,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding LeadScore}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        <TextBlock Text="SCORE" FontSize="9" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Separator Background="#223147"/>

                            <!-- Location Card -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="GEOGRAPHIC LOCATION" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <Grid ColumnDefinitions="*,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding City, StringFormat='City: {0}'}" FontSize="12" Foreground="#F8FAFC"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StateProvince, StringFormat='State: {0}'}" FontSize="12" Foreground="#94A3B8"/>
                                </Grid>
                                <TextBlock Text="{Binding Country, StringFormat='Country: {0}'}" FontSize="12" Foreground="#F8FAFC"/>
                                <TextBlock Text="{Binding AddressLine1, StringFormat='Address: {0}'}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Separator Background="#223147"/>

                            <!-- Contact & Digital Footprint -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="CONTACT &amp; DIGITAL PRESENCE" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding PhonePrimary, StringFormat='Phone: {0}', TargetNullValue='Phone: None'}" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding EmailPrimary, StringFormat='Email: {0}', TargetNullValue='Email: None'}" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding WebsiteUrl, StringFormat='Website: {0}', TargetNullValue='Website: ❌ No Website'}" FontSize="12" Foreground="#38BDF8" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Separator Background="#223147"/>

                            <!-- Tags -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="TAGS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <Border Background="#1E293B" CornerRadius="4" Padding="8">
                                    <TextBlock Text="{Binding Tags, TargetNullValue='No tags assigned'}" FontSize="12" Foreground="#F59E0B" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <Separator Background="#223147"/>

                            <!-- Key Contacts Section -->
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="CONTACTS" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+ Add Contact" 
                                            Command="{Binding ((vm:BusinessesViewModel)DataContext).OpenAddContactModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Classes="btn-secondary" Padding="8,4" FontSize="11"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Contacts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:BusinessContact">
                                            <Border Background="#1A2538" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                                        <TextBlock Text="{Binding JobTitle}" FontSize="11" Foreground="#94A3B8"/>
                                                        <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding Email}" FontSize="11" Foreground="#38BDF8"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="✕" 
                                                            Command="{Binding ((vm:BusinessesViewModel)DataContext).DeleteContactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}"
                                                            Classes="btn-danger-ghost" Padding="6,2" VerticalAlignment="Top"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Separator Background="#223147"/>

                            <!-- Google Places Details (Stage 7) -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsGoogleVerified}">
                                <TextBlock Text="GOOGLE PLACES ENRICHMENT" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="✓ Verified Place" FontSize="12" FontWeight="Bold" Foreground="#34D399"/>
                                            <TextBlock Text="{Binding GoogleRating, StringFormat='★ {0:F1}'}" FontSize="12" FontWeight="Bold" Foreground="#FBBF24"/>
                                            <TextBlock Text="{Binding GoogleReviewCount, StringFormat='({0} reviews)'}" FontSize="12" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding BusinessHours, StringFormat='Hours: {0}'}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding LastEnrichedAtUtc, StringFormat='Last synced: {0:yyyy-MM-dd HH:mm} UTC'}" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Separator Background="#223147"/>

                            <!-- Quick Outreach & Lead Utilities -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="QUICK OUTREACH &amp; ACTIONS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <Button Content="📋 Copy Tailored Pitch" 
                                        Command="{Binding ((vm:BusinessesViewModel)DataContext).CopyQuickPitchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        Classes="btn-accent" HorizontalAlignment="Stretch"/>
                                <Button Content="🎨 AI Landing Page Studio" 
                                        Command="{Binding ((vm:BusinessesViewModel)DataContext).OpenLandingPageStudioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        Classes="btn-accent" HorizontalAlignment="Stretch" ToolTip.Tip="Open AI Landing Page Studio window pre-filled with this business"/>
                                <Button Content="🌐 Launch Website in Browser" 
                                        Command="{Binding ((vm:BusinessesViewModel)DataContext).OpenWebsiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        Classes="btn-primary" HorizontalAlignment="Stretch"
                                        IsVisible="{Binding WebsiteUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <Grid ColumnDefinitions="*,*">
                                    <Button Grid.Column="0" Content="📞 Copy Phone" 
                                            Command="{Binding ((vm:BusinessesViewModel)DataContext).CopyPhoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            Classes="btn-secondary" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                            IsVisible="{Binding PhonePrimary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <Button Grid.Column="1" Content="✉️ Copy Email" 
                                            Command="{Binding ((vm:BusinessesViewModel)DataContext).CopyEmailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            Classes="btn-secondary" HorizontalAlignment="Stretch" Margin="4,0,0,0"
                                            IsVisible="{Binding EmailPrimary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </Grid>
                            </StackPanel>

                            <Separator Background="#223147"/>

                            <!-- Record Management -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="RECORD MANAGEMENT" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <Button Content="✨ Enrich with Google Places" 
                                        Command="{Binding ((vm:BusinessesViewModel)DataContext).OpenEnrichConfirmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        HorizontalAlignment="Stretch" Classes="btn-teal"/>
                                <Button Content="⭐ Toggle Starred"
                                        Command="{Binding ((vm:BusinessesViewModel)DataContext).ToggleStarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch" Classes="btn-secondary"/>
                                <Button Content="🗑️ Delete Business" 
                                        Command="{Binding ((vm:BusinessesViewModel)DataContext).DeleteBusinessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        HorizontalAlignment="Stretch" Classes="btn-danger-ghost"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- 4. MODALS OVERLAYS -->

        <!-- Add Business Modal Overlay -->
        <Border Background="#C0090D16" IsVisible="{Binding IsAddBusinessModalOpen}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Width="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="Add New Enterprise Business" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Enter business details. Duplicate checks across websites &amp; phones run automatically." FontSize="12" Foreground="#94A3B8"/>

                    <StackPanel Spacing="10">
                        <TextBox Text="{Binding NewBusinessName}" PlaceholderText="Business Name (Required)"/>
                        <TextBox Text="{Binding NewBusinessCategory}" PlaceholderText="Category (e.g. Healthcare, Legal, Tech, Logistics)"/>
                        
                        <!-- Country & State -->
                        <Grid ColumnDefinitions="*,*">
                            <TextBox Grid.Column="0" Text="{Binding NewBusinessCountry}" PlaceholderText="Country" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NewBusinessState}" PlaceholderText="State / Province" Margin="6,0,0,0"/>
                        </Grid>

                        <TextBox Text="{Binding NewBusinessCity}" PlaceholderText="City"/>
                        <TextBox Text="{Binding NewBusinessPhone}" PlaceholderText="Primary Phone (e.g. +92 300 1234567)"/>
                        <TextBox Text="{Binding NewBusinessEmail}" PlaceholderText="Primary Email"/>
                        <TextBox Text="{Binding NewBusinessWebsite}" PlaceholderText="Website URL (e.g. https://example.com)"/>
                        <TextBox Text="{Binding NewBusinessTags}" PlaceholderText="Tags (comma-separated)"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding CloseAddBusinessModalCommand}" Classes="btn-secondary"/>
                        <Button Content="Save Business" Command="{Binding SaveNewBusinessCommand}" Classes="btn-primary"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Add Contact Modal Overlay -->
        <Border Background="#C0090D16" IsVisible="{Binding IsAddContactModalOpen}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Width="440" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="Add Key Business Contact" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="{Binding SelectedBusiness.Name, StringFormat='Adding key decision maker for {0}'}" FontSize="12" Foreground="#38BDF8"/>

                    <StackPanel Spacing="10">
                        <TextBox Text="{Binding NewContactFullName}" PlaceholderText="Full Name (Required)"/>
                        <TextBox Text="{Binding NewContactJobTitle}" PlaceholderText="Job Title (e.g. CEO, Principal Doctor, IT Director)"/>
                        <TextBox Text="{Binding NewContactEmail}" PlaceholderText="Email Address"/>
                        <TextBox Text="{Binding NewContactPhone}" PlaceholderText="Direct Phone / WhatsApp"/>
                        <CheckBox Content="Mark as Primary Decision Maker" IsChecked="{Binding NewContactIsPrimary}" Foreground="#F8FAFC"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding CloseAddContactModalCommand}" Classes="btn-secondary"/>
                        <Button Content="Add Contact" Command="{Binding SaveNewContactCommand}" Classes="btn-primary"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- CSV Import Modal Overlay -->
        <Border Background="#C0090D16" IsVisible="{Binding IsImportModalOpen}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Width="640" MaxHeight="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="CSV Spreadsheet Lead Import" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="RFC 4180 compliant CSV parser with automated column synonym mapping &amp; pre-flight duplicate detection." FontSize="12" Foreground="#94A3B8"/>

                    <Border Background="#0F172A" CornerRadius="6" Padding="12" IsVisible="{Binding ImportPreview, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="6" DataContext="{Binding ImportPreview}">
                            <TextBlock Text="{Binding TotalRows, StringFormat='Total Rows: {0}'}" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            <TextBlock Text="{Binding ValidRows, StringFormat='Valid Unique Leads: {0}'}" Foreground="#10B981"/>
                            <TextBlock Text="{Binding DuplicateRows, StringFormat='Potential Duplicates: {0}'}" Foreground="#F59E0B"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="6" Margin="0,6">
                        <TextBlock Text="Duplicate Resolution Strategy:" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,4">
                            <RadioButton Content="Skip Duplicates (Safe)" IsChecked="True" GroupName="DedupStrategy" Foreground="#F8FAFC"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding CloseImportModalCommand}" Classes="btn-secondary" IsEnabled="{Binding !IsImporting}"/>
                        <Button Content="Execute Import" Command="{Binding ExecuteImportCommand}" Classes="btn-primary" IsEnabled="{Binding !IsImporting}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Google Places Enrichment Confirmation Modal Overlay (Stage 7) -->
        <Border Background="#C0090D16" IsVisible="{Binding IsEnrichConfirmModalOpen}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Width="480" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Google Places Enrichment" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Border Grid.Column="1" Background="#064E3B" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="COST GUARD" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>
                    </Grid>
                    
                    <TextBlock Text="{Binding EnrichConfirmMessage}" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="20"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEnrichingWithGoogle}">
                        <ProgressBar IsIndeterminate="True" Width="100" Height="4"/>
                        <TextBlock Text="Querying Google Places API..." FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding CloseEnrichConfirmCommand}" Classes="btn-secondary" IsEnabled="{Binding !IsEnrichingWithGoogle}"/>
                        <Button Content="Confirm &amp; Enrich" Command="{Binding ExecuteGooglePlacesEnrichmentCommand}" Classes="btn-teal" IsEnabled="{Binding !IsEnrichingWithGoogle}" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
