<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TKS.LeadPilot.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="TKS.LeadPilot.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/leadpilot-icon.ico"
        Title="TKS LeadPilot — Enterprise Business Discovery &amp; Intelligence Station"
        MinWidth="1080" MinHeight="700"
        Background="#080C14">

    <Window.Styles>
        <!-- Modern Premium Navigation Button Style -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#151E2E"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>
        <Style Selector="Button.nav:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="230,*" RowDefinitions="56,*">
        <!-- Top Global Status Bar (Layer 1 Elevated Header) -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#0C121E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Brand Identity Mark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="4" VerticalAlignment="Center">
                        <Image Source="/Assets/leadpilot-logo.png" Width="24" Height="24" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="LEADPILOT" FontWeight="ExtraBold" FontSize="15" Foreground="#F8FAFC" LetterSpacing="0.8"/>
                            <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="TheKhanSoft Enterprise Suite" FontSize="10" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Search / Context Info (Visual Accent) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#080C14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="14,5">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚡" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Native Windows Desktop Edition" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Status Indicators & Emergency AI Switch -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Local SQLite Indicator -->
                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" Fill="#10B981"/>
                            <TextBlock Text="{Binding SyncStatusText}" FontSize="11" Foreground="#F8FAFC" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>

                    <!-- AI Free Quota Pill -->
                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🤖 Gemini Free:" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding AiRequestsUsed, StringFormat='{}{0}/1200'}" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>

                    <!-- Emergency AI Kill Switch -->
                    <Button Command="{Binding ToggleEmergencyAiCommand}"
                            Background="#7F1D1D" Foreground="#FCA5A5" CornerRadius="6" Padding="10,4"
                            Content="🛑 AI Guard Active" FontSize="11" FontWeight="SemiBold" IsVisible="{Binding !IsAiEmergencyPaused}"/>
                    <Button Command="{Binding ToggleEmergencyAiCommand}"
                            Background="#991B1B" Foreground="#FEF08A" CornerRadius="6" Padding="10,4"
                            Content="⚠️ AI PAUSED" FontSize="11" FontWeight="Bold" IsVisible="{Binding IsAiEmergencyPaused}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="#0C121E" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="12,16">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="CORE DISCOVERY" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="10,4,0,6" LetterSpacing="0.8"/>
                        
                        <Button Classes="nav" Content="📊 Executive Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                        <Button Classes="nav" Content="🏢 Business Database" Command="{Binding NavigateCommand}" CommandParameter="Businesses"/>
                        <Button Classes="nav" Content="🛰️ Free Discovery (OSM)" Command="{Binding NavigateCommand}" CommandParameter="Businesses"/>

                        <TextBlock Text="INTELLIGENCE &amp; CRM" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="10,16,0,6" LetterSpacing="0.8"/>

                        <Button Classes="nav" Content="🔬 Website Audits" Command="{Binding NavigateCommand}" CommandParameter="Audits"/>
                        <Button Classes="nav" Content="📈 CRM Sales Pipeline" Command="{Binding NavigateCommand}" CommandParameter="Pipeline"/>

                        <TextBlock Text="OUTREACH &amp; CAMPAIGNS" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="10,16,0,6" LetterSpacing="0.8"/>

                        <Button Classes="nav" Content="✉️ Message Studio" Command="{Binding NavigateCommand}" CommandParameter="Messages"/>

                        <TextBlock Text="CONFIGURATION" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="10,16,0,6" LetterSpacing="0.8"/>

                        <Button Classes="nav" Content="⚙️ Settings &amp; Vault" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Operator Card & Version Stamp -->
                <Border Grid.Row="1" Background="#0F1728" BorderBrush="#1E2B42" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,12,0,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Background="#1E2B44" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="15" Width="30" Height="30" Margin="0,0,8,0">
                            <TextBlock Text="TK" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="TheKhanSoft Station" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center"/>
                                <TextBlock Text="v1.0.0 • SQLite Hybrid" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentView}" Background="#080C14"/>
    </Grid>
</Window>
