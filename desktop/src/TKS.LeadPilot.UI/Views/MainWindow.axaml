<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TKS.LeadPilot.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="TKS.LeadPilot.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="TKS LeadPilot — Business Discovery &amp; Intelligence Station"
        MinWidth="1024" MinHeight="680"
        Background="#0B0F19">

    <Grid ColumnDefinitions="220,*" RowDefinitions="52,*">
        <!-- Top Global Status Bar -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#0F172A" BorderBrush="#26334A" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="4" Width="26" Height="26">
                        <TextBlock Text="LP" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TKS LeadPilot" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                        <TextBlock Text="v1.0.0" FontSize="11" Foreground="#94A3B8"/>
                    </Border>
                </StackPanel>

                <!-- Status Indicators & Emergency AI Switch -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <!-- Sync Indicator -->
                    <Border Background="#1E293B" CornerRadius="4" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#10B981"/>
                            <TextBlock Text="{Binding SyncStatusText}" FontSize="12" Foreground="#F8FAFC"/>
                        </StackPanel>
                    </Border>

                    <!-- AI Free Quota Pill -->
                    <Border Background="#1E293B" CornerRadius="4" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🤖 Gemini Free:" FontSize="12" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding AiRequestsUsed, StringFormat='{}{0}/1200'}" FontSize="12" FontWeight="SemiBold" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>

                    <!-- Emergency AI Kill Switch -->
                    <Button Command="{Binding ToggleEmergencyAiCommand}"
                            Background="#7F1D1D" Foreground="#FCA5A5" CornerRadius="4" Padding="10,4"
                            Content="🛑 AI Active" IsVisible="{Binding !IsAiEmergencyPaused}"/>
                    <Button Command="{Binding ToggleEmergencyAiCommand}"
                            Background="#991B1B" Foreground="#FEF08A" CornerRadius="4" Padding="10,4"
                            Content="⚠️ AI PAUSED" IsVisible="{Binding IsAiEmergencyPaused}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="#0F172A" BorderBrush="#26334A" BorderThickness="0,0,1,0" Padding="12,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="6">
                    <TextBlock Text="MAIN NAVIGATION" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="8,0,0,6"/>
                    
                    <Button Content="📊 Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" CornerRadius="6"
                            Background="#1E293B" Foreground="#F8FAFC"/>

                    <Button Content="🏢 Business Database" Command="{Binding NavigateCommand}" CommandParameter="Businesses"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" CornerRadius="6"
                            Background="Transparent" Foreground="#94A3B8"/>

                    <TextBlock Text="INTELLIGENCE &amp; CRM" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="8,12,0,6"/>

                    <Button Content="🔍 Discover Leads" Command="{Binding NavigateCommand}" CommandParameter="Businesses"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" CornerRadius="6"
                            Background="Transparent" Foreground="#94A3B8"/>

                    <Button Content="🔬 Website Audits" Command="{Binding NavigateCommand}" CommandParameter="Businesses"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" CornerRadius="6"
                            Background="Transparent" Foreground="#94A3B8"/>

                    <Button Content="📈 CRM Pipeline" Command="{Binding NavigateCommand}" CommandParameter="Businesses"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" CornerRadius="6"
                            Background="Transparent" Foreground="#94A3B8"/>

                    <Button Content="✉️ Message Studio" Command="{Binding NavigateCommand}" CommandParameter="Businesses"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" CornerRadius="6"
                            Background="Transparent" Foreground="#94A3B8"/>

                    <TextBlock Text="CONFIGURATION" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="8,12,0,6"/>

                    <Button Content="⚙️ Settings &amp; Vault" Command="{Binding NavigateCommand}" CommandParameter="Settings"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" CornerRadius="6"
                            Background="Transparent" Foreground="#94A3B8"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentView}" Background="#0B0F19"/>
    </Grid>
</Window>
