<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKS.LeadPilot.UI.ViewModels"
             x:Class="TKS.LeadPilot.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="System Settings &amp; Vault" FontSize="24" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                <TextBlock Text="Manage local security, Gemini Free Tier API keys, and application preferences." FontSize="13" Foreground="#94A3B8"/>
            </StackPanel>

            <!-- Gemini API Key Card -->
            <Border Background="#0E1626" BorderBrush="#1C283F" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Google Gemini Developer API (Free Tier)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Saved securely in Windows DPAPI vault (CurrentUser scope). Never stored in plain text or exported." FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Gemini API Key (from Google AI Studio)" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBox Text="{Binding GeminiApiKey}" PlaceholderText="AIzaSy..." Background="#0B1322" Foreground="#F8FAFC" BorderBrush="#22324A" CornerRadius="7" Padding="12,8"/>
                    </StackPanel>

                    <!-- Gemini Free Tier Controls (Stage 8) -->
                    <CheckBox IsChecked="{Binding !IsAiDisabled}" Content="Enable Gemini AI Proposal Synthesis &amp; Intelligence" Foreground="#F8FAFC" FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Gemini Free Tier Model" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBox Text="{Binding SelectedGeminiModel}" Width="220" HorizontalAlignment="Left" Background="#0B1322" Foreground="#F8FAFC" BorderBrush="#22324A" CornerRadius="7" Padding="10,6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding DailyAiUsedToday, StringFormat='Requests Used Today: {0}'}" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding DailyAiLimit, StringFormat='Hard Ceiling: {0} RPD (Zero-Cost Policy)'}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="💾 Save to DPAPI Vault" Command="{Binding SaveApiKeyCommand}" Classes="btn-primary" Padding="16,8"/>
                        <Button Content="🔍 Test Vault Key" Command="{Binding TestAiConnectionCommand}" Classes="btn-secondary" Padding="16,8"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="SemiBold" FontSize="12" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Border>

            <!-- Google Places API (New) Commercial Enrichment & Discovery -->
            <Border Background="#0E1626" BorderBrush="#1C283F" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📍 Google Places API (New)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="🛡️ $0.00 Cost Guard Active" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Commercial place intelligence directly from Google Maps Platform. Strictly governed by Highest-Tier SKU limits, mandatory field masks, and zero-cost billing shields." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Enable / Opt-in Toggle -->
                    <CheckBox IsChecked="{Binding IsGooglePlacesEnabled}" Content="Enable Google Places Commercial Enrichment &amp; Discovery" Foreground="#F8FAFC" FontWeight="SemiBold"/>

                    <!-- SKU Tier Selection (Controls Highest-Tier Billing & Field Mask) -->
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Google Places SKU Tier &amp; Field Mask" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                <TextBlock Text="Per Google Maps billing rules, requests are charged at the highest tier of fields requested. Select your quota tier." FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </Grid>
                        <ComboBox ItemsSource="{Binding GooglePlacesSkuTiers}" SelectedItem="{Binding SelectedGooglePlacesSkuTier}" Background="#0B1322" Foreground="#F8FAFC" BorderBrush="#22324A" CornerRadius="7" Padding="12,8" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- API Key Input -->
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Google Cloud API Key (Places API New Enabled)" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="Saved securely in Local Vault" FontSize="11" Foreground="#10B981"/>
                        </Grid>
                        <TextBox Text="{Binding GooglePlacesApiKey}" PlaceholderText="AIzaSy..." Background="#0B1322" Foreground="#F8FAFC" BorderBrush="#22324A" CornerRadius="7" Padding="12,8"/>
                    </StackPanel>

                    <!-- Quota & Live Spending Telemetry -->
                    <Border Background="#0B1322" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,*">
                                <!-- Daily Request Ceiling -->
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                                    <TextBlock Text="Daily Request Hard Ceiling" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Stops queries once daily limit is hit." FontSize="11" Foreground="#64748B"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <TextBox Width="70" Text="{Binding GooglePlacesDailyCeiling}" Background="#0E1626" Foreground="#F8FAFC" BorderBrush="#22324A" CornerRadius="6" Padding="6,4" HorizontalContentAlignment="Center"/>
                                        <TextBlock Text="{Binding GooglePlacesUsedToday, StringFormat='Used: {0}'}" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding GooglePlacesDailyRemaining, StringFormat='({0} left)'}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Monthly Free Tier Cap -->
                                <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,0,0">
                                    <TextBlock Text="Monthly Free Tier Cap Consumption" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Resets on 1st of each month (UTC)." FontSize="11" Foreground="#64748B"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding GooglePlacesMonthlyUsed}" FontSize="14" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding GooglePlacesMonthlyLimit, StringFormat='/ {0:N0} Free Calls'}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding GooglePlacesMonthlyRemaining, StringFormat='({0:N0} remaining)'}" FontSize="11" Foreground="#34D399" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Monthly Quota Progress Bar -->
                            <ProgressBar Value="{Binding GooglePlacesMonthlyUsed}" Maximum="{Binding GooglePlacesMonthlyLimit}" Height="6" Foreground="#10B981" Background="#1E293B" CornerRadius="3"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="💾 Save Places Settings" Command="{Binding SaveGooglePlacesSettingsCommand}" Classes="btn-primary" Padding="16,8"/>
                        <Button Content="⚡ Test API Connection" Command="{Binding TestGooglePlacesConnectionCommand}" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="7" Padding="14,8"/>
                        <Button Content="🔄 Reset Usage Counters" Command="{Binding ResetGooglePlacesCountersCommand}" Background="#0E1626" Foreground="#94A3B8" BorderBrush="#22324A" BorderThickness="1" CornerRadius="7" Padding="12,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Groq Cloud High-Speed AI Engine (100% Free Tier - No Credit Card Needed) -->
            <Border Background="#0E1626" BorderBrush="#1C283F" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="⚡ Groq Cloud High-Speed AI Engine" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="100% FREE TIER" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Ultra-fast Llama-3.3 inference (500 tokens/sec) for autonomous lead discovery and synthesis. Free API key from console.groq.com." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Groq API Key (from console.groq.com)" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBox Text="{Binding GroqApiKey}" PlaceholderText="gsk_..." PasswordChar="●" Background="#0B1322" Foreground="#F8FAFC" BorderBrush="#22324A" CornerRadius="7" Padding="12,8"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Groq AI Model" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBox Text="{Binding SelectedGroqModel}" Width="260" HorizontalAlignment="Left" Background="#0B1322" Foreground="#F8FAFC" BorderBrush="#22324A" CornerRadius="7" Padding="10,6"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="💾 Save Groq Settings" Command="{Binding SaveGroqSettingsCommand}" Classes="btn-primary" Padding="16,8"/>
                        <Button Content="🔍 Test Groq Connection" Command="{Binding TestGroqConnectionCommand}" Classes="btn-secondary" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Serper.dev Google Places & Web Search (Free Tier - 2,500 Queries) -->
            <Border Background="#0E1626" BorderBrush="#1C283F" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🔎 Serper.dev Google Places &amp; Search API" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <Border Background="#0C233C" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="2,500 FREE QUERIES" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Live Google Places and Google Maps search results with 2,500 free queries upon registration at serper.dev (No credit card required)." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Serper API Key (from serper.dev)" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBox Text="{Binding SerperApiKey}" PlaceholderText="api_key..." PasswordChar="●" Background="#0B1322" Foreground="#F8FAFC" BorderBrush="#22324A" CornerRadius="7" Padding="12,8"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="💾 Save Serper Settings" Command="{Binding SaveSerperSettingsCommand}" Classes="btn-primary" Padding="16,8"/>
                        <Button Content="🔍 Test Serper Key" Command="{Binding TestSerperConnectionCommand}" Classes="btn-secondary" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Zero-Configuration Free Discovery Engines Status Card -->
            <Border Background="#0B1322" BorderBrush="#162235" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🌐 Built-In Zero-Configuration Free Engines" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="ALWAYS ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="The following engines run autonomously with 100% free open APIs and require ZERO api keys or tokens:" FontSize="12" Foreground="#94A3B8"/>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <Border Grid.Row="0" Grid.Column="0" Background="#111A2C" CornerRadius="6" Padding="10,8" Margin="3">
                            <StackPanel Spacing="2">
                                <TextBlock Text="⚡ Photon Geosearch (Komoot)" FontWeight="Bold" Foreground="#38BDF8" FontSize="11.5"/>
                                <TextBlock Text="OpenStreetMap-powered Elasticsearch fuzzy POI search." FontSize="10.5" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Background="#111A2C" CornerRadius="6" Padding="10,8" Margin="3">
                            <StackPanel Spacing="2">
                                <TextBlock Text="🦆 DuckDuckGo Commercial Web" FontWeight="Bold" Foreground="#F59E0B" FontSize="11.5"/>
                                <TextBlock Text="Web crawler extracting live business directories &amp; websites." FontSize="10.5" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="#111A2C" CornerRadius="6" Padding="10,8" Margin="3">
                            <StackPanel Spacing="2">
                                <TextBlock Text="🛰️ OpenStreetMap Overpass QL" FontWeight="Bold" Foreground="#34D399" FontSize="11.5"/>
                                <TextBlock Text="Global real-time amenity, shop, healthcare &amp; office nodes." FontSize="10.5" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Background="#111A2C" CornerRadius="6" Padding="10,8" Margin="3">
                            <StackPanel Spacing="2">
                                <TextBlock Text="🗺️ OSM Nominatim Geocoder" FontWeight="Bold" Foreground="#A78BFA" FontSize="11.5"/>
                                <TextBlock Text="Natural language geographic and commercial point queries." FontSize="10.5" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Central Laravel Headless API Synchronization (Stage 11) -->
            <Border Background="#0E1626" BorderBrush="#1C283F" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Central Laravel Headless API &amp; Synchronization" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            <TextBlock Text="Bidirectional delta synchronization with universal UUIDs, idempotent push/pull, and Server-Wins conflict resolution." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{Binding IsSyncOnline, Converter={x:Static ObjectConverters.IsNotNull}}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding IsSyncOnline, StringFormat='API Online: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                        </Border>
                    </Grid>

                    <!-- API Base URL -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Central API Endpoint URL" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBox Text="{Binding SyncApiBaseUrl}" PlaceholderText="http://127.0.0.1:8000/api/v1" Background="#0B1322" Foreground="#F8FAFC" BorderBrush="#22324A" CornerRadius="7" Padding="12,8"/>
                    </StackPanel>

                    <!-- Sanctum API Token -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Sanctum Bearer Token (Optional for dev-sync)" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBox Text="{Binding SyncApiToken}" PlaceholderText="1|sanctum_token..." PasswordChar="●" Background="#0B1322" Foreground="#F8FAFC" BorderBrush="#22324A" CornerRadius="7" Padding="12,8"/>
                    </StackPanel>

                    <!-- Device Information -->
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                            <TextBlock Text="Device Name" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBox Text="{Binding SyncDeviceName}" Background="#0B1322" Foreground="#F8FAFC" BorderBrush="#22324A" CornerRadius="7" Padding="10,6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                            <TextBlock Text="Universal Device UUID" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBox Text="{Binding SyncDeviceId}" IsReadOnly="True" Background="#080C14" Foreground="#94A3B8" BorderBrush="#22324A" CornerRadius="7" Padding="10,6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Last Synced Status -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Last Synced:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SyncLastSyncedAt}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="💾 Save Settings" Command="{Binding SaveSyncSettingsCommand}" Classes="btn-primary" Padding="14,8"/>
                        <Button Content="📡 Test API Health" Command="{Binding CheckSyncHealthCommand}" Classes="btn-secondary" Padding="14,8"/>
                        <Button Content="🔄 Sync Now" Command="{Binding TriggerSyncNowCommand}" IsEnabled="{Binding !IsSyncing}" Classes="btn-success" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- AI Rate Limiter & Zero Billing -->
            <Border Background="#0E1626" BorderBrush="#1C283F" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Zero-Unexpected-Billing Policy Enforcement" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="The hard spending limit is locked to $0.00. Automatic fallback to paid models or paid tiers is architecturally forbidden." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                    
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Daily Free Quota Ceiling" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            <TextBlock Text="Once reached, AI operations pause until 00:00 UTC." FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="1,200 requests/day" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Per-Minute Safety Rate Limit" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            <TextBlock Text="Prevents triggering provider HTTP 429 rate limit exceptions." FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="12 RPM (Max 15)" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Local Database Maintenance -->
            <Border Background="#0E1626" BorderBrush="#1C283F" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Local Storage (SQLite Engine)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Database location: %LOCALAPPDATA%\TKS.LeadPilot\tks_leadpilot.db" FontSize="12" Foreground="#94A3B8"/>
                    <TextBlock Text="Engine: SQLite 3 with Entity Framework Core 10.0 • Offline-First Universal UUIDv4" FontSize="12" Foreground="#64748B"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
