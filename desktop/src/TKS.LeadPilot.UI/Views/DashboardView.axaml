<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKS.LeadPilot.UI.ViewModels"
             x:Class="TKS.LeadPilot.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="24">
            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Executive Dashboard" FontSize="24" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    <TextBlock Text="At-a-glance discovery, website status, opportunities, and outreach pipelines." FontSize="13" Foreground="#94A3B8"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🔄 Refresh Data" Command="{Binding LoadStatisticsAsync}" Background="#1E293B" Foreground="#38BDF8" CornerRadius="6" Padding="12,8"/>
            </Grid>

            <!-- KPI Metric Cards Grid -->
            <Grid ColumnDefinitions="*,*,*,*" Margin="0,8,0,0">
                <!-- Discovered Businesses -->
                <Border Grid.Column="0" Margin="0,0,8,0" Background="#151E2E" BorderBrush="#26334A" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="TOTAL DISCOVERED" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalBusinesses}" FontSize="32" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Stored in local SQLite" FontSize="12" Foreground="#10B981"/>
                    </StackPanel>
                </Border>

                <!-- Businesses With Website -->
                <Border Grid.Column="1" Margin="4,0,4,0" Background="#151E2E" BorderBrush="#26334A" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="WITH WEBSITE" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding WithWebsiteCount}" FontSize="32" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock Text="Active digital presence" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Businesses Without Website -->
                <Border Grid.Column="2" Margin="4,0,4,0" Background="#151E2E" BorderBrush="#26334A" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="MISSING WEBSITE (HOT LEADS)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding NoWebsiteCount}" FontSize="32" FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock Text="Web dev opportunity" FontSize="12" Foreground="#F59E0B"/>
                    </StackPanel>
                </Border>

                <!-- High Opportunity Score -->
                <Border Grid.Column="3" Margin="8,0,0,0" Background="#151E2E" BorderBrush="#26334A" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="HIGH OPPORTUNITY (70+)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding HighOpportunityCount}" FontSize="32" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBlock Text="Priority outreach targets" FontSize="12" Foreground="#10B981"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Highlights Section -->
            <Grid ColumnDefinitions="2*,1*" Margin="0,8,0,0">
                <!-- Activity & Opportunities -->
                <Border Grid.Column="0" Margin="0,0,8,0" Background="#151E2E" BorderBrush="#26334A" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Immediate High-Priority Actions" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        
                        <Border Background="#1E293B" CornerRadius="6" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="🔴" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Apex Dental &amp; Implant Care — Missing HTTPS Encryption" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Lahore • Lead Score: 88 • Recommend: TKS Website Security Retainer" FontSize="12" Foreground="#94A3B8"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="View Audit" Background="#2563EB" Foreground="#FFFFFF" CornerRadius="4" Padding="10,6"/>
                            </Grid>
                        </Border>

                        <Border Background="#1E293B" CornerRadius="6" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="🟡" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Careway Pharmacy &amp; Diagnostic — No Website Detected" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Karachi • Lead Score: 78 • Recommend: Modern Business Website" FontSize="12" Foreground="#94A3B8"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Draft Pitch" Background="#2563EB" Foreground="#FFFFFF" CornerRadius="4" Padding="10,6"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Quota & System Health -->
                <Border Grid.Column="1" Margin="8,0,0,0" Background="#151E2E" BorderBrush="#26334A" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="System &amp; Quota Health" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Gemini Free Tier API" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Grid.Column="1" Text="12 / 1200 RPD" FontSize="12" FontWeight="SemiBold" Foreground="#10B981"/>
                            </Grid>
                            <ProgressBar Value="12" Maximum="1200" Height="6" Foreground="#10B981" Background="#1E293B"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="OSM Discovery Rate" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Grid.Column="1" Text="OK (1 req/s)" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            </Grid>
                            <ProgressBar Value="10" Maximum="100" Height="6" Foreground="#38BDF8" Background="#1E293B"/>
                        </StackPanel>

                        <Border Background="#0F172A" BorderBrush="#26334A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="🔒 Zero-Cost Billing Enforced" FontWeight="SemiBold" FontSize="12" Foreground="#10B981"/>
                                <TextBlock Text="Hard ceiling of $0.00 is active. Automatic paid fallback is disabled." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
