<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKS.LeadPilot.UI.ViewModels"
             x:Class="TKS.LeadPilot.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" Spacing="24">
            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Executive Dashboard" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Border Background="#1E293B" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="LIVE INTELLIGENCE" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Comprehensive discovery health, website intelligence signals, opportunity pipeline, and quota tracking." FontSize="13" Foreground="#94A3B8"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🔄 Refresh Data" Command="{Binding LoadStatisticsAsync}" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14,8" FontWeight="SemiBold"/>
            </Grid>

            <!-- KPI Metric Cards Grid with Modern Gradient Top Accents -->
            <Grid ColumnDefinitions="*,*,*,*" Margin="0,4,0,0">
                <!-- Total Discovered -->
                <Border Grid.Column="0" Margin="0,0,8,0" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0" Background="#3B82F6" Height="3" CornerRadius="2" Margin="0,0,0,14"/>
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="TOTAL DISCOVERED" FontSize="11" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.5"/>
                            <TextBlock Text="{Binding TotalBusinesses}" FontSize="34" FontWeight="ExtraBold" Foreground="#F8FAFC"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Stored in local SQLite" FontSize="12" Foreground="#10B981" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- Businesses With Website -->
                <Border Grid.Column="1" Margin="4,0,4,0" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0" Background="#0EA5E9" Height="3" CornerRadius="2" Margin="0,0,0,14"/>
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="WITH WEBSITE" FontSize="11" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.5"/>
                            <TextBlock Text="{Binding WithWebsiteCount}" FontSize="34" FontWeight="ExtraBold" Foreground="#38BDF8"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Active digital presence" FontSize="12" Foreground="#94A3B8" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- Businesses Missing Website -->
                <Border Grid.Column="2" Margin="4,0,4,0" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0" Background="#F59E0B" Height="3" CornerRadius="2" Margin="0,0,0,14"/>
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="MISSING WEBSITE (HOT LEADS)" FontSize="11" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.5"/>
                            <TextBlock Text="{Binding NoWebsiteCount}" FontSize="34" FontWeight="ExtraBold" Foreground="#FBBF24"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Prime web development targets" FontSize="12" Foreground="#F59E0B" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- High Opportunity Score -->
                <Border Grid.Column="3" Margin="8,0,0,0" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0" Background="#10B981" Height="3" CornerRadius="2" Margin="0,0,0,14"/>
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="HIGH OPPORTUNITY (70+)" FontSize="11" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.5"/>
                            <TextBlock Text="{Binding HighOpportunityCount}" FontSize="34" FontWeight="ExtraBold" Foreground="#34D399"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Priority outreach targets" FontSize="12" Foreground="#10B981" Margin="0,8,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Highlights Section -->
            <Grid ColumnDefinitions="2*,1*" Margin="0,4,0,0">
                <!-- Activity & Opportunities -->
                <Border Grid.Column="0" Margin="0,0,8,0" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="22">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Immediate High-Priority Actions" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        
                        <Border Background="#151E2E" BorderBrush="#26334A" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Background="#4C0519" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="🔴 CRITICAL" FontSize="10" FontWeight="Bold" Foreground="#FB7185"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Apex Dental &amp; Implant Care — Missing HTTPS Encryption" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Lahore • Lead Score: 88 • Recommend: TKS Website Security Retainer" FontSize="12" Foreground="#94A3B8"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="View Audit" Background="#2563EB" Foreground="#FFFFFF" CornerRadius="6" Padding="12,6" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>

                        <Border Background="#151E2E" BorderBrush="#26334A" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Background="#451A03" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="🟡 NO SITE" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Careway Pharmacy &amp; Diagnostic — No Website Detected" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Karachi • Lead Score: 78 • Recommend: Modern Business Website" FontSize="12" Foreground="#94A3B8"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Draft Pitch" Background="#2563EB" Foreground="#FFFFFF" CornerRadius="6" Padding="12,6" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Quota & System Health -->
                <Border Grid.Column="1" Margin="8,0,0,0" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="22">
                    <StackPanel Spacing="16">
                        <TextBlock Text="System &amp; Quota Health" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Gemini Free Tier API" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Grid.Column="1" Text="12 / 1200 RPD" FontSize="12" FontWeight="SemiBold" Foreground="#10B981"/>
                            </Grid>
                            <ProgressBar Value="12" Maximum="1200" Height="6" Foreground="#10B981" Background="#1E293B" CornerRadius="3"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Google Places Hard Ceiling" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Grid.Column="1" Text="0 / 50 Today" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            </Grid>
                            <ProgressBar Value="0" Maximum="50" Height="6" Foreground="#38BDF8" Background="#1E293B" CornerRadius="3"/>
                        </StackPanel>

                        <Border Background="#0C121E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,6,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="🔒 Zero-Cost Billing Enforced" FontWeight="Bold" FontSize="12" Foreground="#10B981"/>
                                <TextBlock Text="Hard ceiling of $0.00 is active. Commercial fallback is disabled." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
