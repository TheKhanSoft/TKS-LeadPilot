<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKS.LeadPilot.UI.ViewModels"
             xmlns:m="using:TKS.LeadPilot.Core.Models"
             x:Class="TKS.LeadPilot.UI.Views.PipelineView"
             x:DataType="vm:PipelineViewModel">

    <Grid>
        <!-- Main Layout -->
        <Grid RowDefinitions="Auto,Auto,*" Margin="24">
            <!-- 1. Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="CRM Sales Pipeline &amp; Lead Scoring" FontSize="22" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Deterministic lead scoring, transparent component breakdown, TKS service matching, and sales stage workflow." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="6" Padding="12,6">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#38BDF8"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 2. Stage Ribbon Bar -->
            <Border Grid.Row="1" Background="#0E1626" BorderBrush="#1C283F" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,16">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Stages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:PipelineStage">
                                <Button Content="{Binding Name}"
                                        Command="{Binding ((vm:PipelineViewModel)DataContext).MoveToStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}"
                                        Classes="btn-secondary"
                                        IsEnabled="{Binding ((vm:PipelineViewModel)DataContext).IsLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static BoolConverters.Not}}"
                                        Padding="14,7" FontSize="12"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 3. Split Pipeline Master-Detail -->
            <Grid Grid.Row="2" ColumnDefinitions="1.2*,1.8*">
                <!-- Left: Stage Leads DataGrid -->
                <Border Grid.Column="0" Margin="0,0,8,0" Background="#0E1626" BorderBrush="#1C283F" BorderThickness="1" CornerRadius="10">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Stage Selector Filter Dropdown -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="14,12,14,10">
                            <TextBlock Grid.Column="0" Text="Filter by Stage:" FontSize="12" Foreground="#64748B" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Stages}" SelectedItem="{Binding SelectedStage}" IsEnabled="{Binding !IsLoading}" Background="#0B1322" Foreground="#F8FAFC" BorderBrush="#22324A" CornerRadius="7">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:PipelineStage">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding StageBusinesses}"
                                  SelectedItem="{Binding SelectedBusiness}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  RowBackground="#0E1626"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Lead Name" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="City" Binding="{Binding City}" Width="1*" />
                                <DataGridTextColumn Header="Score" Binding="{Binding LeadScore}" Width="0.8*" />
                                <DataGridTextColumn Header="Website" Binding="{Binding WebsiteStatus}" Width="1.2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Right: Detailed CRM Inspector & Explainable Score -->
                <Border Grid.Column="1" Margin="8,0,0,0" Background="#0E1626" BorderBrush="#1C283F" BorderThickness="1" CornerRadius="10" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" IsVisible="{Binding SelectedBusiness, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <!-- Lead Header & Quick Stage Transition -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding SelectedBusiness.Name}" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedBusiness.Category, StringFormat='Category: {0}'}" FontSize="12" Foreground="#38BDF8"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                    <!-- Opportunity Score Badge -->
                                    <Border Background="#10B981" CornerRadius="6" Padding="12,6">
                                        <TextBlock Text="{Binding SelectedBusiness.LeadScore, StringFormat='Score: {0}/100'}" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Quick Stage Buttons -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="STAGE TRANSITIONS" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <WrapPanel>
                                    <Button Content="→ Qualified" Command="{Binding MoveToStageCommand}" CommandParameter="stage-qualified" Classes="btn-secondary" Margin="0,0,6,6"/>
                                    <Button Content="→ Researching" Command="{Binding MoveToStageCommand}" CommandParameter="stage-researching" Classes="btn-secondary" Margin="0,0,6,6"/>
                                    <Button Content="→ Proposal Sent" Command="{Binding MoveToStageCommand}" CommandParameter="stage-proposal-sent" Classes="btn-secondary" Margin="0,0,6,6"/>
                                    <Button Content="→ Negotiation" Command="{Binding MoveToStageCommand}" CommandParameter="stage-negotiation" Classes="btn-secondary" Margin="0,0,6,6"/>
                                    <Button Content="🏆 Won" Command="{Binding MoveToStageCommand}" CommandParameter="stage-won" Classes="btn-success" Margin="0,0,6,6"/>
                                    <Button Content="✕ Lost" Command="{Binding MoveToStageCommand}" CommandParameter="stage-lost" Classes="btn-danger" Margin="0,0,6,6"/>
                                </WrapPanel>
                            </StackPanel>

                            <Separator Background="#26334A"/>

                            <!-- Explainable Lead Scoring Card (Stage 9 Requirement) -->
                            <Border Background="#0F172A" BorderBrush="#26334A" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="TRANSPARENT LEAD SCORING BREAKDOWN" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                            <TextBlock Text="Every score is 100% reproducible and explainable based on audited signals." FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="🔄 Recalculate" Command="{Binding RecalculateScoreCommand}" Classes="btn-secondary" Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Grid.Column="2" Content="✏️ Override Score" Command="{Binding OpenOverrideModalCommand}" Classes="btn-accent" Padding="8,4" FontSize="11"/>
                                    </Grid>

                                    <!-- Score Components List -->
                                    <ItemsControl ItemsSource="{Binding ScoreComponents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:LeadScoreComponent">
                                                <Border Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <TextBlock Text="{Binding ComponentName}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                                            <TextBlock Text="{Binding Explanation}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="#0F172A" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PointsAwarded, StringFormat='+{0} pts'}" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Separator Background="#26334A"/>

                            <!-- Matched TKS Services Card -->
                            <Border Background="#0F172A" BorderBrush="#26334A" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="EVIDENCE-BASED TKS SERVICE RECOMMENDATIONS" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <ItemsControl ItemsSource="{Binding MatchedServices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:TksServiceMatch">
                                                <Border Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding Service.Name}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                            <Border Grid.Column="1" Background="#047857" CornerRadius="4" Padding="6,2">
                                                                <TextBlock Text="{Binding MatchConfidence, StringFormat='{}{0}% Match'}" FontSize="10" FontWeight="Bold" Foreground="#D1FAE5"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding MatchReason, StringFormat='Reason: {0}'}" FontSize="11" Foreground="#38BDF8"/>
                                                        <TextBlock Text="{Binding GeneratedPitch, StringFormat='Pitch: {0}'}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Separator Background="#26334A"/>

                            <!-- Tasks & Reminders -->
                            <Border Background="#0F172A" BorderBrush="#26334A" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="FOLLOW-UP TASKS &amp; REMINDERS" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>

                                    <!-- Add Task Input -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding NewTaskTitle}" PlaceholderText="Enter follow-up task..." Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6" Padding="8,6" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Content="+ Add Task" Command="{Binding AddTaskCommand}" Classes="btn-primary" Padding="12,6"/>
                                    </Grid>

                                    <!-- Task Items -->
                                    <ItemsControl ItemsSource="{Binding Tasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:SalesTask">
                                                <Border Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" 
                                                                  Command="{Binding ((vm:PipelineViewModel)DataContext).ToggleTaskCompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding .}"
                                                                  Margin="0,0,10,0"/>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#F8FAFC" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding DueDatePktDisplay, StringFormat='Due: {0}'}" FontSize="10" Foreground="#64748B"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="✕" 
                                                                Command="{Binding ((vm:PipelineViewModel)DataContext).DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding Id}"
                                                                Classes="btn-danger-ghost" Padding="6,2"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Separator Background="#26334A"/>

                            <!-- Activity Timeline & Notes -->
                            <Border Background="#0F172A" BorderBrush="#26334A" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="SALES NOTES &amp; ACTIVITY TIMELINE" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>

                                    <!-- Add Note Input -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding NewNoteContent}" PlaceholderText="Log call notes, meeting feedback, or research findings..." Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6" Padding="8,6" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Content="+ Log Note" Command="{Binding AddNoteCommand}" Classes="btn-secondary" Padding="12,6"/>
                                    </Grid>

                                    <!-- Note Items -->
                                    <ItemsControl ItemsSource="{Binding Notes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:SalesNote">
                                                <Border Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <TextBlock Text="{Binding Content}" FontSize="12" Foreground="#F8FAFC" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding FormattedPktTimestamp}" FontSize="10" Foreground="#64748B"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="✕" 
                                                                Command="{Binding ((vm:PipelineViewModel)DataContext).DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding Id}"
                                                                Classes="btn-danger-ghost" Padding="6,2" VerticalAlignment="Top"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- 4. Manual Score Override Modal Overlay -->
        <Border Background="#C0090D16" IsVisible="{Binding IsOverrideModalOpen}">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Width="440" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="Manual Lead Score Override" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Set a manual opportunity score. All manual overrides require an audit reason." FontSize="12" Foreground="#94A3B8"/>

                    <StackPanel Spacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding OverrideScore, StringFormat='Opportunity Score: {0}/100'}" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                            <NumericUpDown Value="{Binding OverrideScore}" Minimum="0" Maximum="100" Increment="5" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Mandatory Reason for Override:" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding OverrideReason}" PlaceholderText="e.g. VIP client referral, high budget..." Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6" AcceptsReturn="True" Height="80"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding CloseOverrideModalCommand}" Classes="btn-secondary"/>
                        <Button Content="Save Override" Command="{Binding ApplyManualOverrideCommand}" Classes="btn-accent" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
