<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TKS.LeadPilot.UI.App"
             xmlns:local="using:TKS.LeadPilot.UI"
             RequestedThemeVariant="Dark">
             <!-- Set Dark theme default for modern SaaS aesthetic -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- Global Modern Theme Enhancements -->
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.94"/>
        </Style>

        <!-- Modern DataGrid Styling -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="#0D1524"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#172236"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#090E18"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="#152238"/>
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="#1E3252"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Modern Input Controls Styling -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22324A"/>
            <Setter Property="Background" Value="#0B1322"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Background" Value="#0F1A2E"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22324A"/>
            <Setter Property="Background" Value="#0B1322"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="#38BDF8"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Modern Elevation Cards -->
        <Style Selector="Border.card-panel">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Border.card-panel-elevated">
            <Setter Property="Background" Value="#131D31"/>
            <Setter Property="BorderBrush" Value="#22324A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- Button Variants -->
        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.btn-secondary">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A3B52"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.btn-accent">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <Style Selector="Button.btn-accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0369A1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.btn-purple">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <Style Selector="Button.btn-purple:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#6D28D9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Quick Filter Pill Buttons -->
        <Style Selector="Button.pill-filter">
            <Setter Property="Background" Value="#152033"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#263750"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.pill-filter:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E2E48"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>
        <Style Selector="Button.pill-active">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Suggested Niche Pills -->
        <Style Selector="Button.niche-pill">
            <Setter Property="Background" Value="#0A223B"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="BorderBrush" Value="#17446F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.niche-pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#133C64"/>
            <Setter Property="Foreground" Value="#7DD3FC"/>
        </Style>
    </Application.Styles>
</Application>
